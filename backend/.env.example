# Local storage and browser origin
TASK_STORAGE_DIR=./backend/data/tasks
CORS_ORIGINS=http://localhost:3000,http://localhost:8788
DEFAULT_GLOSSARY_PATH=/absolute/path/to/服装日语式样书术语库.xlsx

# Default is safe local glossary replacement only.
TRANSLATION_PROVIDER=glossary-local

# To use a standard replaceable translation service:
# TRANSLATION_PROVIDER=openai-compatible
# TRANSLATION_API_BASE=https://your-provider.example/v1
# TRANSLATION_API_KEY=replace-me
# TRANSLATION_MODEL=your-model

# macOS experiment: reuse secrets already stored by RetainPDF Desktop.
# TRANSLATION_PROVIDER=retain-desktop
# OCR_PROVIDER=paddle
# RETAIN_DESKTOP_CONFIG_PATH=/Users/you/Library/Application Support/retain-pdf-desktop/desktop-config.json
# PADDLE_MODEL=PP-StructureV3

# Optional CJK font path for PDF writeback
# PDF_CJK_FONT=/absolute/path/to/NotoSansCJK-Regular.ttc
